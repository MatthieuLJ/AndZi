<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.matthieu"
          android:versionCode="1"
          android:versionName="1.0">

    <uses-sdk android:minSdkVersion="4"
              android:targetSdkVersion="8" />
        
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <supports-screens
            android:resizeable="true"
            android:smallScreens="true"
            android:normalScreens="true"
            android:largeScreens="true"
            android:anyDensity="true"/>

    <application
            android:label="@string/app_name"
            android:name="AndZiApplication">
        <activity
                android:name=".MainMenuActivity"
                android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".EditLessonsActivity"
                  android:windowSoftInputMode="stateHidden|adjustPan"
                />
        <activity android:name=".AddVocabularyActivity"
                  android:windowSoftInputMode="stateHidden|adjustPan"
                  android:configChanges="keyboardHidden|orientation"
                />

        <activity android:name=".DBActivity"/>

        <activity android:name=".Test"
                android:launchMode="singleTop"/>
        <activity android:name=".GuessTone"
                  android:configChanges="keyboardHidden|orientation"/>
        <activity android:name=".GuessMissingChar"
                  android:configChanges="keyboardHidden|orientation"/>
        <activity android:name=".GuessChineseWord"
                  android:configChanges="keyboardHidden|orientation"/>
        <activity android:name=".GuessPinyin"
                  android:configChanges="keyboardHidden|orientation"/>
        <activity android:name=".GuessEnglish"
                  android:configChanges="keyboardHidden|orientation"/>
        <activity android:name=".GuessContaining"
                  android:configChanges="keyboardHidden|orientation"/>

        <activity android:name=".ReviewList" />
        <activity android:name=".Details"
                  android:launchMode="singleTop" />
        <activity android:name=".Dictionary"
                  android:windowSoftInputMode="stateHidden|adjustPan" />

        <activity android:name=".Credits" />
        <activity android:name=".settings.Settings" />
        <activity android:name=".settings.ExportDB">
            <intent-filter android:name="android.intent.action.MAIN" />
        </activity>
        <activity android:name=".settings.EmailDB">
            <intent-filter android:name="android.intent.action.MAIN" />
        </activity>

        <activity android:name=".widget.file_dialog.FileDialog" />

        <activity android:name=".EmptyActivity"
                android:theme="@android:style/Theme.NoDisplay"/>

        <receiver android:name=".BootBroadcastReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <service android:enabled="true" android:name=".ProgressService"/>

    </application>
</manifest> 
