<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.matthieu"
          android:versionCode="1"
          android:versionName="1.0">
    <application
            android:label="@string/app_name"
            android:name="AndZiApplication">
        <activity
                android:name=".MainMenuActivity"
                android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".EditLessonsActivity" />
        <activity android:name=".AddVocabularyActivity" />
        <intent-filter android:name="android.intent.action.EDIT" />
        <activity android:name=".GuessTone" />
        <activity android:name=".DBActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.azdb" />
                <data android:host="*" />
            </intent-filter>
        </activity>
        <activity android:name=".GuessChar" />
        <activity android:name=".widget.file_dialog.FileDialog" />
        <activity android:name=".TestResultActivity">
            <intent-filter android:name="android.intent.action.VIEW" />
        </activity>
        <activity android:name=".AndZiPreferences" />
        <activity android:name=".GuessChineseWord" />
        <activity android:name=".ReviewList" />
        <activity android:name=".GuessPinyin" />

    </application>
    <supports-screens
            android:resizeable="true"
            android:smallScreens="true"
            android:normalScreens="true"
            android:largeScreens="true"
            android:anyDensity="true"/>
    
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-sdk android:minSdkVersion="4"
              android:targetSdkVersion="8" />
</manifest> 
