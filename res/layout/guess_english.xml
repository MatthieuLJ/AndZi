<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
    <View
            android:id="@+id/spacer"
            android:layout_height="0dp"
            android:layout_width="match_parent"
            android:layout_weight="1"
            />
    <TextView
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:gravity="center_horizontal"
            android:textColor="@android:color/black"
            android:textSize="@dimen/large_text"
            android:text="@string/guess_english"
            />
    <TextView
            android:id="@+id/guess_english_word_voc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/black"
            android:textSize="@dimen/xlarge_text"
            android:gravity="center_horizontal"
            />
    <View
            android:layout_height="0dp"
            android:layout_width="match_parent"
            android:layout_weight="1"
            />

    <LinearLayout
            android:id="@+id/english_test_focusable_linear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:focusableInTouchMode="true"
            >
        <EditText
                android:id="@+id/english_test_guess"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                style="@style/edit_text"
                android:hint="@string/test_your_answer"
                android:textSize="@dimen/large_text"
                android:imeOptions="actionDone"
                />
        <Button
                android:id="@+id/guess_english_ok"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/button"
                android:text="@string/ok"/>
    </LinearLayout>
</LinearLayout>