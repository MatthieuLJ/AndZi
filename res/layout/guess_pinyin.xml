<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        style="@style/AndZiTheme">
    <View
            android:id="@+id/spacer"
            android:layout_height="0dp"
            android:layout_width="match_parent"
            android:layout_weight="1"
            />
    <TextView
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:gravity="center_horizontal"
            android:textColor="#000000"
            android:text="@string/guess_pinyin" />
    <TextView
            android:id="@+id/guess_pinyin_chinese"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:textSize="40sp"
            android:textColor="#000000"
            />
    <Button
            android:id="@+id/guess_pinyin_show_words"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#00000000"
            android:textColor="#000000"
            android:text="@string/as_in"
            />
    <com.matthieu.widget.ShrinkingScrollView
            android:scrollbars="vertical"
            android:layout_height="0dp"
            android:layout_width="match_parent"
            android:layout_weight="3"
            >
        <TableLayout
                android:id="@+id/guess_pinyin_word_grid"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:stretchColumns="1"
                android:visibility="gone"
                />
    </com.matthieu.widget.ShrinkingScrollView>
    <View
            android:layout_height="0dp"
            android:layout_width="match_parent"
            android:layout_weight="1"
            />
    <LinearLayout
            android:id="@+id/pinyin_test_focusable_linear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:focusableInTouchMode="true"
            >
        <EditText
                android:id="@+id/pinyin_test_guess"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="#000000"
                android:imeOptions="actionDone"
                />
        <Button
                android:id="@+id/guess_pinyin_ok"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ok"
                />
    </LinearLayout>
    <View
            android:layout_height="0dp"
            android:layout_width="match_parent"
            android:layout_weight="1"
            />
</LinearLayout>