<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
    <View
            android:id="@+id/spacer"
            android:layout_height="0dp"
            android:layout_width="match_parent"
            android:layout_weight="1"
            />
    <TextView
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:gravity="center_horizontal"
            android:textColor="@android:color/black"
            android:textSize="@dimen/large_test_text"
            android:text="@string/guess_pinyin" />
    <TextView
            android:id="@+id/guess_pinyin_chinese"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:textSize="@dimen/xlarge_test_text"
            android:textColor="@android:color/black"
            android:textIsSelectable="false"
            />
    <Button
            android:id="@+id/guess_pinyin_show_words"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/transparent"
            android:textColor="@android:color/black"
            android:textSize="@dimen/normal_test_text"
            android:text="@string/as_in"
            />
    <ScrollView
            android:scrollbars="vertical"
            android:layout_height="0dp"
            android:layout_width="match_parent"
            android:layout_weight="3"
            >
        <TableLayout
                android:id="@+id/guess_pinyin_word_grid"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:stretchColumns="1"
                android:visibility="gone"
                />
    </ScrollView>
    <View
            android:layout_height="0dp"
            android:layout_width="match_parent"
            android:layout_weight="1"
            />
    <LinearLayout
            android:id="@+id/pinyin_test_focusable_linear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:focusableInTouchMode="true"
            >
        <EditText
                android:id="@+id/pinyin_test_guess"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                style="@style/edit_text"
                android:hint="@string/test_your_answer"
                android:textSize="@dimen/large_test_text"
                android:imeOptions="actionDone"
                />
        <Button
                android:id="@+id/guess_pinyin_ok"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/button"
                android:text="@string/ok"
                android:textSize="@dimen/large_test_text"
                />
    </LinearLayout>
</LinearLayout>