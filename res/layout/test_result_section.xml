<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="vertical"
        android:background="#dddddd">
    <TextView
            android:id="@+id/test_result_pinyin"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textColor="#000000"
            />
    <LinearLayout
            android:id="@+id/test_result_translations"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            />
    <View
            android:id="@+id/test_result_separator"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/separation_line_thickness"
            android:layout_margin="@dimen/separation_line_margin"
            android:background="@color/separation_line_color" />
</LinearLayout>