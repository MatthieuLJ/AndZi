<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:expandable="http://schemas.android.com/apk/res/com.matthieu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/AndZiTheme"
        >

<com.matthieu.widget.ExtendingLinearLayout
            android:id="@+id/edit_lesson_new_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">
        <View
                android:id="@+id/edit_lesson_grab"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:visibility="gone"
                />
        <EditText
                android:id="@+id/edit_new_lesson"
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:hint="@string/edit_lesson_new"
                android:textColor="#000000"
                android:layout_weight="1"
                expandable:hidable="true"
                />
        <Button
                android:id="@+id/edit_new_lesson_ok"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/ok"
                expandable:hidable="true"
                />
    </com.matthieu.widget.ExtendingLinearLayout>
</LinearLayout>