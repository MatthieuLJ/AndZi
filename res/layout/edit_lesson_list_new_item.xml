<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:expandable="http://schemas.android.com/apk/res/com.matthieu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
    <com.matthieu.widget.ExtendingLinearLayout
            android:id="@+id/edit_lesson_new_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

        <ImageView
                android:id="@+id/add_new_lesson_plus"
                android:layout_height="36dp"
                android:layout_width="match_parent"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@color/half_transparent"
                android:src="@drawable/plus"
                android:scaleType="centerInside"
                android:contentDescription="@string/add_voc_description_new_lesson"/>

        <View
                android:id="@+id/edit_lesson_grab"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:visibility="gone"
                />
        <EditText
                android:id="@+id/edit_new_lesson"
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                style="@style/edit_text"
                android:hint="@string/edit_lesson_new"
                android:textSize="@dimen/large_text"
                android:layout_weight="1"
                expandable:hidable="true"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                />
        <Button
                android:id="@+id/edit_new_lesson_ok"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                style="@style/button"
                android:text="@string/ok"
                expandable:hidable="true"
                android:layout_marginRight="10dp"
                />
    </com.matthieu.widget.ExtendingLinearLayout>
</LinearLayout>