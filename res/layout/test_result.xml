<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="vertical"
        android:background="#dddddd">
    <TextView
            android:id="@+id/test_result_chinese"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:textSize="40sp"
            android:textColor="#000000"
            />
    <LinearLayout
            android:id="@+id/test_results"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            />
    <View
            android:id="@+id/test_result_separator"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/separation_line_thickness"
            android:layout_margin="@dimen/separation_line_margin"
            android:background="@color/separation_line_color" />
    <TextView
            android:id="@+id/test_result_guess"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textSize="24sp"
            android:textColor="#dd0000"
            android:visibility="gone"
            />
    <LinearLayout
            android:id="@+id/test_result_wrong_guess"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone"
            />
    <Button
            android:layout_height="wrap_content"
            android:layout_width="fill_parent"
            android:text="Next"
            android:onClick="handle_next"
            />

</LinearLayout>