<?xml version="1.0" encoding="utf-8"?>

<com.matthieu.widget.AdaptiveLinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:expandable="http://schemas.android.com/apk/res/com.matthieu"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="vertical"
        style="@style/AndZiTheme">
    <View
            android:id="@+id/spacer"
            android:layout_height="0dp"
            android:layout_width="fill_parent"
            android:layout_weight="1"
            />
    <TextView
            android:layout_height="wrap_content"
            android:layout_width="fill_parent"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:gravity="center_horizontal"
            android:textColor="#000000"
            android:text="@string/guess_containing"
            />
    <TextView
            android:id="@+id/guess_containing_chinese"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textColor="#000000"
            android:gravity="center_horizontal"
            />
    <View
            android:layout_height="0dp"
            android:layout_width="fill_parent"
            android:layout_weight="1"
            />

    <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >
        <EditText
                android:id="@+id/guess_containing_word_guess"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:capitalize="none"
                android:singleLine="true"
                android:imeOptions="actionDone"
                />
        <Button
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="@string/ok"
                android:onClick="handle_ok"/>
    </LinearLayout>
    <View
            android:layout_height="0dp"
            android:layout_width="fill_parent"
            android:layout_weight="1"
            expandable:hidable="true" />
</com.matthieu.widget.AdaptiveLinearLayout>