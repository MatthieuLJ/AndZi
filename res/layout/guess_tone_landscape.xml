<?xml version="1.0" encoding="utf-8"?>

<android.gesture.GestureOverlayView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/guess_tone_gestureview"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:gestureStrokeType="single"
        android:gestureStrokeLengthThreshold="200.0"
        android:gestureStrokeAngleThreshold="0.0"
        >
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
        <TextView
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:gravity="center_horizontal"
                android:textColor="@android:color/black"
                android:textSize="@dimen/large_test_text"
                android:text="@string/find_tone" />
        <TextView
                android:id="@+id/guess_tone_chinese"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|top"
                android:textSize="@dimen/xlarge_test_text"
                android:textColor="@android:color/black"
                android:textIsSelectable="false"
                />
        <TextView
                android:id="@+id/guess_tone_pinyin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|top"
                android:textColor="@android:color/black"
                android:textSize="@dimen/large_test_text"
                android:textIsSelectable="false"
                />

        <View
                android:layout_height="0dp"
                android:layout_width="match_parent"
                android:layout_weight="1"
                />
        <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:baselineAligned="false"
                android:orientation="horizontal">
            <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|center_horizontal"
                    android:layout_weight="1"
                    >
                <TableRow
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:gravity="center_horizontal"
                        >
                    <CheckBox
                            android:id="@+id/guess_tone_first_tone"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:layout_gravity="center"

                            />
                    <ImageView
                            android:id="@+id/guess_tone_first_tone_image"
                            android:layout_height="24sp"
                            android:layout_width="wrap_content"
                            android:layout_gravity="center"
                            android:src="@drawable/first_tone"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/description_1st_tone"
                            />
                    <TextView
                            android:id="@+id/guess_tone_first_tone_text"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="@string/first_tone"
                            android:textColor="@android:color/black"
                            android:textSize="@dimen/normal_test_text"
                            android:layout_gravity="center"
                            />
                </TableRow>
                <TableRow
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:gravity="center_horizontal"
                        >
                    <CheckBox
                            android:id="@+id/guess_tone_second_tone"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:layout_gravity="center"

                            />
                    <ImageView
                            android:id="@+id/guess_tone_second_tone_image"
                            android:layout_height="24sp"
                            android:layout_width="wrap_content"
                            android:layout_gravity="center"
                            android:src="@drawable/second_tone"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/description_2nd_tone"
                            />
                    <TextView
                            android:id="@+id/guess_tone_second_tone_text"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="@string/second_tone"
                            android:textColor="@android:color/black"
                            android:textSize="@dimen/normal_test_text"
                            android:layout_gravity="center"
                            />
                </TableRow>
            </TableLayout>
            <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|center_horizontal"
                    android:layout_weight="1"
                    >
                <TableRow
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:gravity="center_horizontal"
                        >
                    <CheckBox
                            android:id="@+id/guess_tone_third_tone"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:layout_gravity="center"

                            />
                    <ImageView
                            android:id="@+id/guess_tone_third_tone_image"
                            android:layout_height="24sp"
                            android:layout_width="wrap_content"
                            android:layout_gravity="center"
                            android:src="@drawable/third_tone"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/description_3rd_tone"
                            />
                    <TextView
                            android:id="@+id/guess_tone_third_tone_text"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="@string/third_tone"
                            android:textColor="@android:color/black"
                            android:textSize="@dimen/normal_test_text"
                            android:layout_gravity="center"
                            />
                </TableRow>
                <TableRow
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:gravity="center_horizontal"
                        >
                    <CheckBox
                            android:id="@+id/guess_tone_fourth_tone"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:layout_gravity="center"

                            />
                    <ImageView
                            android:id="@+id/guess_tone_fourth_tone_image"
                            android:layout_height="24sp"
                            android:layout_width="wrap_content"
                            android:layout_gravity="center"
                            android:src="@drawable/fourth_tone"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/description_4th_tone"
                            />
                    <TextView
                            android:id="@+id/guess_tone_fourth_tone_text"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="@string/fourth_tone"
                            android:textColor="@android:color/black"
                            android:textSize="@dimen/normal_test_text"
                            android:layout_gravity="center"
                            />
                </TableRow>
            </TableLayout>
        </LinearLayout>
        <View
                android:layout_height="0dp"
                android:layout_width="match_parent"
                android:layout_weight="1"/>

        <Button
                android:id="@+id/guess_tone_ok"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                style="@style/button"
                android:text="@string/ok"
                android:textSize="@dimen/large_test_text"/>
    </LinearLayout>
</android.gesture.GestureOverlayView>