<?xml version="1.0" encoding="utf-8"?>

<TableLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
    <TableRow
            android:layout_height="0dp"
            android:layout_weight="1"
            >
        <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/main_menu_add_voc"
                android:onClick="handle_add_vocabulary" />
    </TableRow>

    <TableRow
            android:layout_height="0dp"
            android:layout_weight="1"
            >

        <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/main_menu_test"
                android:onClick="handle_test" />
    </TableRow>
    <TableRow
            android:layout_height="0dp"
            android:layout_weight="1"
            >
        <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/main_menu_dict"
                android:onClick="handle_dictionary" />
    </TableRow>
    <TableRow
            android:layout_height="0dp"
            android:layout_weight="1"
            >
        <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/main_menu_help"
                android:onClick="handle_help" />

        <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/main_menu_settings"
                android:onClick="handle_prefs" />

    </TableRow>

</TableLayout>