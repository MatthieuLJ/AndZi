<?xml version="1.0" encoding="utf-8"?>

<android.gesture.GestureOverlayView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/tone_tester_gestureview"
        android:layout_height="fill_parent"
        android:layout_width="fill_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gestureStrokeType="single"
        android:gestureStrokeLengthThreshold="200.0"
        android:gestureStrokeAngleThreshold="0.0"
        >
    <LinearLayout

            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:orientation="vertical"
            android:background="#dddddd">
        <TextView
                android:id="@+id/tone_test_chinese"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|top"
                android:textSize="40sp"
                android:textColor="#000000"
                />
        <TextView
                android:id="@+id/tone_test_pinyin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|top"
                android:textColor="#000000"
                />

        <View
                android:layout_height="fill_parent"
                android:layout_width="fill_parent"
                android:layout_weight="1"
                />
        <TableLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|center_horizontal"
                >
            <TableRow
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:gravity="center_horizontal"
                    >
                <CheckBox
                        android:id="@+id/tone_test_first_tone"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:layout_gravity="center"

                        />
                <ImageView
                        android:layout_height="24sp"
                        android:layout_width="wrap_content"
                        android:layout_gravity="center"
                        android:src="@drawable/first_tone"
                        android:scaleType="fitCenter"
                        />
                <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="1st tone"
                        android:textColor="#000000"
                        android:layout_gravity="center"
                        />
            </TableRow>
            <TableRow
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:gravity="center_horizontal"
                    >
                <CheckBox
                        android:id="@+id/tone_test_second_tone"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:layout_gravity="center"

                        />
                <ImageView
                        android:layout_height="24sp"
                        android:layout_width="wrap_content"
                        android:layout_gravity="center"
                        android:src="@drawable/second_tone"
                        android:scaleType="fitCenter"
                        />
                <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="2nd tone"
                        android:textColor="#000000"
                        android:layout_gravity="center"
                        />
            </TableRow>
            <TableRow
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:gravity="center_horizontal"
                    >
                <CheckBox
                        android:id="@+id/tone_test_third_tone"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:layout_gravity="center"

                        />
                <ImageView
                        android:layout_height="24sp"
                        android:layout_width="wrap_content"
                        android:layout_gravity="center"
                        android:src="@drawable/third_tone"
                        android:scaleType="fitCenter"
                        />
                <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="3rd tone"
                        android:textColor="#000000"
                        android:layout_gravity="center"
                        />
            </TableRow>
            <TableRow
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:gravity="center_horizontal"
                    >
                <CheckBox
                        android:id="@+id/tone_test_fourth_tone"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:layout_gravity="center"

                        />
                <ImageView
                        android:layout_height="24sp"
                        android:layout_width="wrap_content"
                        android:layout_gravity="center"
                        android:src="@drawable/fourth_tone"
                        android:scaleType="fitCenter"
                        />
                <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="4th tone"
                        android:textColor="#000000"
                        android:layout_gravity="center"
                        />
            </TableRow>
        </TableLayout>
        <View
                android:layout_height="fill_parent"
                android:layout_width="fill_parent"
                android:layout_weight="1"/>

        <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="fill_parent"
                android:orientation="horizontal"
                android:gravity="bottom">
            <Button
                    android:id="@+id/tone_tester_cancel"
                    android:layout_height="wrap_content"
                    android:layout_width="fill_parent"
                    android:layout_weight="1"
                    android:text="Give up"
                    android:onClick="handle_cancel"/>
            <Button
                    android:id="@+id/tone_tester_submit"
                    android:layout_height="wrap_content"
                    android:layout_width="fill_parent"
                    android:layout_weight="1"
                    android:text="OK"
                    android:onClick="handle_ok"/>
        </LinearLayout>
    </LinearLayout>
</android.gesture.GestureOverlayView>