<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="vertical"
        android:background="#dddddd">
    <TextView
            android:id="@+id/tone_test_chinese"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:layout_gravity="center_horizontal|top"
            android:textSize="40sp"
            android:textColor="#000000"
            />
    <TextView
            android:id="@+id/tone_test_pinyin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:textColor="#000000"
            />
    <CheckBox
            android:id="@+id/tone_test_first_tone"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="ˉ (1st tone)"
            android:layout_gravity="center_horizontal"
            android:textColor="#000000"
            />
    <CheckBox
            android:id="@+id/tone_test_second_tone"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="ˊ (2nd tone)"
            android:layout_gravity="center_horizontal"
            android:textColor="#000000"
            />
    <CheckBox
            android:id="@+id/tone_test_third_tone"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="˅ (3rd tone)"
            android:layout_gravity="center_horizontal"
            android:textColor="#000000"
            />
    <CheckBox
            android:id="@+id/tone_test_fourth_tone"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="ˋ (4th tone)"
            android:layout_gravity="center_horizontal"
            android:textColor="#000000"
            />
    <CheckBox
            android:id="@+id/tone_test_fifth_tone"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="⌀ (no tone)"
            android:layout_gravity="center_horizontal"
            android:textColor="#000000"
            />
    <View
        android:layout_height="fill_parent"
        android:layout_width="fill_parent"
        android:layout_weight="1"/>
    <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="fill_parent"
            android:orientation="horizontal"
            android:gravity="bottom">
        <Button
                android:id="@+id/tone_tester_cancel"
                android:layout_height="wrap_content"
                android:layout_width="fill_parent"
                android:layout_weight="1"
                android:text="Give up"
                android:onClick="handle_cancel"/>
        <Button
                android:id="@+id/tone_tester_submit"
                android:layout_height="wrap_content"
                android:layout_width="fill_parent"
                android:layout_weight="1"
                android:text="OK"
                android:onClick="handle_ok"/>
            </LinearLayout>
</LinearLayout>