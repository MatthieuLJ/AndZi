<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="vertical"
        android:background="#dddddd">
    <TextView
            android:id="@+id/guess_chinese_word_voc"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textColor="#000000"
            />

    <LinearLayout
            android:id="@+id/guess_chinese_word_more_voc_linear"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
        <View
            android:id="@+id/guess_chinese_word_separator"
            android:layout_height="@dimen/separation_line_thickness"
            android:layout_width="fill_parent"
            android:layout_marginTop="@dimen/separation_line_margin"
            android:background="@color/separation_line_color" />
        <Button
            android:id="@+id/guess_chinese_word_more_voc_button"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:background="#dddddd"
            android:gravity="center_horizontal"
            android:onClick="more_voc"
            android:text="show more vocabulary"
            />
    </LinearLayout>
    <TextView
            android:id="@+id/guess_chinese_word_more_voc"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="#000000" />
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >
        <EditText
            android:id="@+id/guess_chinese_word_guess"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:capitalize="none"
            android:singleLine="true"
            android:imeOptions="actionDone"
            />
        <Button
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="OK"
            android:onClick="handle_ok"/>
        </LinearLayout>
    <TextView
                android:id="@+id/guess_chinese_word_previous_guess"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="#000000" />

</LinearLayout>