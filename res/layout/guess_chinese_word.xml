<?xml version="1.0" encoding="utf-8"?>

<com.matthieu.widget.AdaptiveLinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res/com.matthieu"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="vertical"
        android:background="#dddddd">
    <View
            android:id="@+id/spacer"
            android:layout_height="0dp"
            android:layout_width="fill_parent"
            android:layout_weight="1" />
    <TextView
            android:layout_height="wrap_content"
            android:layout_width="fill_parent"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:gravity="center_horizontal"
            android:textColor="#000000"
            android:text="Find the Chinese translation for:" />
    <TextView
            android:id="@+id/guess_chinese_word_voc"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textColor="#000000"
            android:gravity="center_horizontal"
            />
    <View
            android:layout_height="0dp"
            android:layout_width="fill_parent"
            android:layout_weight="1" />
    <Button
            android:id="@+id/guess_chinese_word_more_voc_button"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:background="#dddddd"
            android:gravity="center_horizontal"
            android:onClick="more_voc"
            android:text="show more vocabulary"
            />
    <ScrollView
            android:id="@+id/guess_chinese_word_more_voc_scroll"
            android:scrollbars="vertical"
            android:layout_height="0dp"
            android:layout_width="fill_parent"
            android:measureAllChildren="true"
            android:layout_weight="4"
            android:fillViewport="false"
            app:hidable="true"
            app:scroll="true"
            >
        <TextView
                android:id="@+id/guess_chinese_word_more_voc"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="#000000" />
    </ScrollView>
    <View
            android:id="@+id/guess_chinese_word_more_spacer"
            android:layout_height="0dp"
            android:layout_width="fill_parent"
            android:layout_weight="1"
            app:hidable="true" />
    <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >
        <EditText
                android:id="@+id/guess_chinese_word_guess"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:capitalize="none"
                android:singleLine="true"
                android:imeOptions="actionDone"
                />
        <Button
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="OK"
                android:onClick="handle_ok"/>
    </LinearLayout>
    <TextView
            android:id="@+id/guess_chinese_word_previous_guess"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#000000"
            app:hidable="true" />
    <View
            android:layout_height="0dp"
            android:layout_width="fill_parent"
            android:layout_weight="1"
            app:hidable="true" />

</com.matthieu.widget.AdaptiveLinearLayout>