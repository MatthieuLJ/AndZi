<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/adaptive_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
    <View
            android:id="@+id/spacer"
            android:layout_height="0dp"
            android:layout_width="match_parent"
            android:layout_weight="1" />
    <TextView
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:gravity="center_horizontal"
            android:textColor="@android:color/black"
            android:textSize="@dimen/large_test_text"
            android:text="@string/guess_chinese" />
    <View
            android:layout_height="0dp"
            android:layout_width="match_parent"
            android:layout_weight="1" />
    <TextView
            android:id="@+id/guess_chinese_word_voc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="8"
            android:textColor="@android:color/black"
            android:textSize="@dimen/xlarge_test_text"
            android:gravity="center_horizontal"
            android:scrollbars="vertical"
            android:textIsSelectable="false"
            />
    <Button
            android:id="@+id/guess_chinese_word_more_voc_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:background="@color/transparent"
            android:text="@string/more_vocabulary"
            android:textColor="@android:color/black"
            android:textSize="@dimen/normal_test_text"
            />
    <TextView
            android:id="@+id/guess_chinese_word_more_voc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/black"
            android:textSize="@dimen/normal_test_text"
            android:gravity="center_horizontal"
            android:layout_weight="3"
            android:scrollbars="vertical"
            android:visibility="gone"/>
    <View
            android:id="@+id/guess_chinese_word_more_spacer"
            android:layout_height="0dp"
            android:layout_width="match_parent"
            android:layout_weight="1"
            />
    <LinearLayout
            android:id="@+id/chinese_work_focusable_linear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:focusableInTouchMode="true"
            >
        <EditText
                android:id="@+id/chinese_word_test_guess"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                style="@style/edit_text"
                android:textSize="@dimen/large_test_text"
                android:imeOptions="actionDone"
                />
        <Button
                android:id="@+id/guess_chinese_word_ok"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/button"
                android:text="@string/ok"
                android:textSize="@dimen/large_test_text"/>
    </LinearLayout>
    <TextView
            android:id="@+id/guess_chinese_word_previous_guess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/black"
            android:textSize="@dimen/normal_test_text"
            android:visibility="gone"
            />

</LinearLayout>