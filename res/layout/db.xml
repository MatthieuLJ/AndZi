<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        >
    <TableLayout
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_width="wrap_content"
            android:stretchColumns="false"
            >
        <TableRow
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        <TableRow
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
            <TextView
                    android:layout_marginLeft="10sp"
                    android:layout_marginRight="4sp"
                    android:id="@+id/stats_chars"
                    android:gravity="right"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/large_text"
                    />
            <TextView
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/normal_text"
                    android:text="@string/num_chars"
                    />
        </TableRow>
        <TableRow
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
            <TextView
                    android:layout_marginLeft="10sp"
                    android:layout_marginRight="4sp"
                    android:id="@+id/stats_words"
                    android:gravity="right"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/large_text"
                    />
            <TextView
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/normal_text"
                    android:text="@string/num_words"
                    />
        </TableRow>
        <TableRow
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
            <TextView
                    android:layout_marginLeft="10sp"
                    android:layout_marginRight="4sp"
                    android:id="@+id/stats_to_study"
                    android:gravity="right"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/large_text"
                    />
            <TextView
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/normal_text"
                    android:text="@string/num_to_study"
                    />
        </TableRow>
        <TableRow
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
    </TableLayout>
    <com.matthieu.widget.ProgressGraph
            android:id="@+id/graph"
            android:layout_height="0dp"
            android:layout_width="match_parent"
            android:layout_weight="1" />

    <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:orientation="horizontal">
        <Button
                android:id="@+id/graph_in"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2sp"
                style="@style/button"
                android:text="@string/zoom_in" />
        <Button
                android:id="@+id/graph_out"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2sp"
                style="@style/button"
                android:text="@string/zoom_out" />
    </LinearLayout>

</LinearLayout>