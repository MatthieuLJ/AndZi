<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="vertical"
        style="@style/AndZiTheme"
        >
    <TableLayout
            android:layout_height="wrap_content"
            android:layout_width="fill_parent"
            android:stretchColumns="1"
            >
        <TableRow>
            <TextView
                    android:textColor="#000000"
                    android:text="@string/num_chars"
                    />
            <TextView
                    android:id="@+id/stats_chars"
                    android:gravity="right"
                    android:textColor="#000000"
                    />
        </TableRow>
        <TableRow>
            <TextView
                    android:textColor="#000000"
                    android:text="@string/num_words"
                    />
            <TextView
                    android:id="@+id/stats_words"
                    android:gravity="right"
                    android:textColor="#000000"
                    />
        </TableRow>
        <TableRow>
            <TextView
                    android:textColor="#000000"
                    android:text="@string/num_to_study"
                    />
            <TextView
                    android:id="@+id/stats_to_study"
                    android:gravity="right"
                    android:textColor="#000000"
                    />
        </TableRow>
    </TableLayout>
    <com.matthieu.widget.ProgressGraph
            android:id="@+id/graph"
            android:layout_height="0dp"
            android:layout_width="fill_parent"
            android:layout_weight="1" />

    <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="fill_parent"
            android:orientation="horizontal">
        <Button
                android:id="@+id/graph_in"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_weight="1"
                android:text="@string/zoom_in" />
        <Button
                android:id="@+id/graph_out"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_weight="1"
                android:text="@string/zoom_out" />
    </LinearLayout>

</LinearLayout>