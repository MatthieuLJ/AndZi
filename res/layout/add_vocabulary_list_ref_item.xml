<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:id="@+id/add_line_item"
        style="@style/AndZiTheme">

    <TextView
            android:id="@+id/add_word"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#000000"
            android:textSize="20sp"
            android:clickable="true"
            android:onClick="handle_word_click"
            />

    <View
            android:layout_height="fill_parent"
            android:layout_width="@dimen/separation_line_thickness"
            android:layout_margin="@dimen/separation_line_margin"
            android:background="@color/separation_line_color" />
    <CheckBox
            android:id="@+id/add_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
</LinearLayout>