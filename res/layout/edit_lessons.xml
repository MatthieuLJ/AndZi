<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tlv="http://schemas.android.com/apk/res/com.matthieu"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="vertical"
        android:background="#dddddd">

    <com.matthieu.widget.TouchListView
            android:id="@+id/lesson_list"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:drawSelectorOnTop="false"
            tlv:grabber="@+id/edit_lesson_grab"
            tlv:remove_mode="slideRight"
            />
    <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:minHeight="?android:attr/listPreferredItemHeight">
        <TextView
                android:id="@+id/new_lesson_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New lesson:"
                />
        <EditText
                android:id="@+id/edit_new_lesson"
                android:layout_height="wrap_content"
                android:layout_width="fill_parent"
                android:layout_weight="1"
                android:singleLine="true"
                />
        <Button
                android:id="@+id/edit_lesson_delete"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Delete"
                android:onClick="handle_delete_lesson"
                />
        <Button
                android:id="@+id/edit_new_lesson_ok"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="OK"
                android:onClick="handle_add_lesson"
                />
    </LinearLayout>
    <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="fill_parent"
            android:orientation="horizontal"
            >
        <Button
                android:id="@+id/edit_lesson_cancel"
                android:layout_height="wrap_content"
                android:layout_width="fill_parent"
                android:layout_weight="1"
                android:text="Cancel"
                android:onClick="handle_cancel"/>
        <Button
                android:id="@+id/edit_lesson_submit"
                android:layout_height="wrap_content"
                android:layout_width="fill_parent"
                android:layout_weight="1"
                android:text="OK"
                android:onClick="handle_ok"/>
    </LinearLayout>
</LinearLayout>
        
