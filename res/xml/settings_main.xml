<?xml version="1.0" encoding="utf-8"?>

<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory
            android:title="Appearance">
        <android.preference.CheckBoxPreference
                android:title="@string/settings_colored_pinyins"
                android:key="color_pinyin"
                android:defaultValue="true"
                android:summary="Show different tones with colors"
                />
        <ListPreference
                android:title="@string/settings_show_correct_answer"
                android:summary="Customize when you want to see the correct answer when doing a test"
                android:key="show_result"
                android:defaultValue="1"
                android:entries="@array/result_preference"
                android:entryValues="@array/result_preference_values"
                />
    </PreferenceCategory>

    <PreferenceCategory
            android:title="@string/settings_db_operations">
        <PreferenceScreen
                android:title="@string/settings_db_export"
                android:key="ExportDB">
            <intent
                    android:action="android.intent.action.MAIN"
                    android:targetPackage="com.matthieu"
                    android:targetClass="com.matthieu.settings.ExportDB"
                    />
        </PreferenceScreen>
        <PreferenceScreen
                android:title="@string/settings_db_email"
                android:key="EmailDB">
            <intent
                    android:action="android.intent.action.MAIN"
                    android:targetPackage="com.matthieu"
                    android:targetClass="com.matthieu.settings.EmailDB"
                    />
        </PreferenceScreen>
        <Preference
                android:title="@string/settings_db_reset_scores"
                android:key="ResetDB"
                />
        <Preference
                android:title="@string/settings_db_clear"
                android:key="ClearDB"
                />
        <com.matthieu.settings.TrimProgressPreference
                android:title="@string/settings_db_forget_progress"
                android:key="TrimProgress"
                />
        <PreferenceScreen
                android:title="@string/settings_db_import"
                android:key="ImportDB"
                />
    </PreferenceCategory>

    <PreferenceCategory
            android:title="@string/settings_ref_db">
        <CheckBoxPreference
                android:title="@string/settings_ref_db_enable"
                android:defaultValue="true"
                android:summary="Enable the use for reference database"
                android:key="ref_enabled"
                />
        <Preference
                android:title="@string/settings_ref_db_download"
                android:key="DownloadRef"
                />
        <Preference
                android:title="@string/settings_ref_db_erase"
                android:key="ClearRef"
                />
    </PreferenceCategory>
    <PreferenceCategory
            android:title="Extra">
        <Preference
                android:title="Export Progress"
                android:key="ExportProgress"
                />
        <Preference
                android:title="Import Progress"
                android:key="ImportProgress"
                />
    </PreferenceCategory>
</PreferenceScreen>