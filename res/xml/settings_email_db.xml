<?xml version="1.0" encoding="utf-8"?>

<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android">
    <CheckBoxPreference
            android:title="@string/settings_include_scores"
            android:defaultValue="false"
            android:key="include_scores"
            />
    <CheckBoxPreference
            android:title="@string/settings_select_lessons"
            android:defaultValue="false"
            android:summary="@string/settings_select_lessons_summary"
            android:key="selected_lessons"
            />
    <Preference
            android:title="@string/settings_email"
            android:key="do_email"
            />
</PreferenceScreen>