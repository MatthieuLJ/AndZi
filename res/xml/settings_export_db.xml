<?xml version="1.0" encoding="utf-8"?>

<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android">
    <CheckBoxPreference
            android:title="Include scores"
            android:defaultValue="false"
            android:summary="Include current scores with database"
            android:key="include_scores"
            />
    <CheckBoxPreference
            android:title="Export filtered lessons"
            android:defaultValue="false"
            android:summary="Only include current filtered lessons"
            android:key="only_filtered"
            />
    <EditTextPreference
            android:title="File path"
            android:summary="Destination"
            android:key="export_path"
            />
    <Preference
            android:title="Export"
            android:key="do_export"
            />
</PreferenceScreen>