<?xml version="1.0" encoding="utf-8"?>

<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android">
    <CheckBoxPreference
            android:title="@string/settings_include_scores"
            android:defaultValue="false"
            android:key="include_scores"
            />
    <CheckBoxPreference
            android:title="@string/settings_include_filters"
            android:defaultValue="false"
            android:summary="@string/settings_include_filters_summary"
            android:key="only_filtered"
            />
    <EditTextPreference
            android:title="@string/settings_file_path"
            android:summary="@string/settings_file_path_summary"
            android:key="export_path"
            />
    <Preference
            android:title="@string/settings_export"
            android:key="do_export"
            />
</PreferenceScreen>