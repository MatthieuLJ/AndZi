<?xml version="1.0" encoding="utf-8"?>

<android.gesture.GestureOverlayView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/guess_tone_gestureview"
        android:layout_height="fill_parent"
        android:layout_width="fill_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gestureStrokeType="single"
        android:gestureStrokeLengthThreshold="200.0"
        android:gestureStrokeAngleThreshold="0.0"
        >
    <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:orientation="vertical"
            android:background="#dddddd">
        <TextView
                android:layout_height="wrap_content"
                android:layout_width="fill_parent"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:gravity="center_horizontal"
                android:textColor="#000000"
                android:text="Find the tone for:" />
        <TextView
                android:id="@+id/guess_tone_chinese"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|top"
                android:textSize="40sp"
                android:textColor="#000000"
                />
        <TextView
                android:id="@+id/guess_tone_pinyin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|top"
                android:textColor="#000000"
                />

        <View
                android:layout_height="0dp"
                android:layout_width="fill_parent"
                android:layout_weight="1"
                />
        <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="fill_parent"
                android:orientation="horizontal">
            <TableLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|center_horizontal"
                    android:layout_weight="1"
                    >
                <TableRow
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:gravity="center_horizontal"
                        >
                    <CheckBox
                            android:id="@+id/guess_tone_first_tone"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:layout_gravity="center"

                            />
                    <ImageView
                            android:layout_height="24sp"
                            android:layout_width="wrap_content"
                            android:layout_gravity="center"
                            android:src="@drawable/first_tone"
                            android:scaleType="fitCenter"
                            />
                    <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="1st tone"
                            android:textColor="#000000"
                            android:layout_gravity="center"
                            />
                </TableRow>
                <TableRow
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:gravity="center_horizontal"
                        >
                    <CheckBox
                            android:id="@+id/guess_tone_second_tone"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:layout_gravity="center"

                            />
                    <ImageView
                            android:layout_height="24sp"
                            android:layout_width="wrap_content"
                            android:layout_gravity="center"
                            android:src="@drawable/second_tone"
                            android:scaleType="fitCenter"
                            />
                    <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="2nd tone"
                            android:textColor="#000000"
                            android:layout_gravity="center"
                            />
                </TableRow>
            </TableLayout>
            <TableLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|center_horizontal"
                    android:layout_weight="1"
                    >
                <TableRow
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:gravity="center_horizontal"
                        >
                    <CheckBox
                            android:id="@+id/guess_tone_third_tone"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:layout_gravity="center"

                            />
                    <ImageView
                            android:layout_height="24sp"
                            android:layout_width="wrap_content"
                            android:layout_gravity="center"
                            android:src="@drawable/third_tone"
                            android:scaleType="fitCenter"
                            />
                    <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="3rd tone"
                            android:textColor="#000000"
                            android:layout_gravity="center"
                            />
                </TableRow>
                <TableRow
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:gravity="center_horizontal"
                        >
                    <CheckBox
                            android:id="@+id/guess_tone_fourth_tone"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:layout_gravity="center"

                            />
                    <ImageView
                            android:layout_height="24sp"
                            android:layout_width="wrap_content"
                            android:layout_gravity="center"
                            android:src="@drawable/fourth_tone"
                            android:scaleType="fitCenter"
                            />
                    <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="4th tone"
                            android:textColor="#000000"
                            android:layout_gravity="center"
                            />
                </TableRow>
            </TableLayout>
        </LinearLayout>
        <View
                android:layout_height="0dp"
                android:layout_width="fill_parent"
                android:layout_weight="1"/>

        <Button
                android:id="@+id/tone_tester_submit"
                android:layout_height="wrap_content"
                android:layout_width="fill_parent"
                android:text="OK"
                android:onClick="handle_ok"/>
    </LinearLayout>
</android.gesture.GestureOverlayView>