<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".AndZiApplication"
        android:allowBackup="true"
        android:icon="@drawable/zi_icon"
        android:label="@string/app_name"
        android:logo="@drawable/zi_icon_notification"
        android:theme="@style/Theme_Sherlock">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainMenuActivity"
            android:exported="false" />

        <activity
            android:name=".TestActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ReferenceActivity"
            android:exported="false"
            android:windowSoftInputMode="stateHidden|adjustPan" />

        <activity
            android:name=".Help"
            android:exported="false" />

        <activity
            android:name=".settings.Settings"
            android:exported="false" />

        <activity
            android:name=".settings.ExportDB"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.EmailDB"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.file_dialog.FileDialog"
            android:exported="false" />

        <activity
            android:name=".EmptyActivity"
            android:enabled="false"
            android:exported="false"
            android:theme="@android:style/Theme.NoDisplay" />

        <activity
            android:name=".ComposeTestActivity"
            android:exported="false" />

        <receiver
            android:name=".BootBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".ScreenBroadcastReceiver"
            android:exported="false" />

        <service
            android:name=".ProgressService"
            android:enabled="true"
            android:exported="false" />

    </application>
</manifest>
