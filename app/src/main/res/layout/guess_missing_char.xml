<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <View
            android:id="@+id/spacer"
            android:layout_height="0dp"
            android:layout_width="match_parent"
            android:layout_weight="1"/>
    <TextView
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:gravity="center_horizontal"
            android:textColor="@android:color/black"
            android:textSize="@dimen/large_test_text"
            android:text="@string/guess_char" />
    <View
            android:layout_height="0dp"
            android:layout_width="match_parent"
            android:layout_weight="1"
            />
    <ScrollView
            android:scrollbars="vertical"
            android:layout_height="0dp"
            android:layout_width="match_parent"
            android:layout_weight="4"
            >

        <TableLayout
                android:id="@+id/char_finder_word_grid"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:stretchColumns="1"
                />
    </ScrollView>
    <View
            android:layout_height="0dp"
            android:layout_width="match_parent"
            android:layout_weight="1"/>

    <LinearLayout
            android:id="@+id/missing_test_focusable_linear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:focusableInTouchMode="true"
            >
        <EditText
                android:id="@+id/missing_test_guess"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                style="@style/edit_text"
                android:hint="@string/test_your_answer"
                android:textSize="@dimen/large_test_text"
                android:imeOptions="actionDone"
                />
        <Button
                android:id="@+id/guess_missing_char_ok"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/button"
                android:text="@string/ok"
                android:textSize="@dimen/large_test_text"/>
    </LinearLayout>
    <TextView
            android:id="@+id/char_finder_previous_guess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/black"
            android:textSize="@dimen/normal_test_text"
            android:visibility="gone"
            />
</LinearLayout>
