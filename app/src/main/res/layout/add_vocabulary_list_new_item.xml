<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:expandable="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal">
    <com.matthieu.flash.widget.ExtendingLinearLayout
            android:id="@+id/add_voc_new_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

        <ImageView
                android:id="@+id/add_new_translation_plus"
                android:layout_height="36dp"
                android:layout_width="match_parent"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@color/half_transparent"
                android:src="@drawable/plus"
                android:scaleType="centerInside"
                android:contentDescription="@string/add_voc_description_new_translation"
                />

        <EditText
                android:id="@+id/add_new_translation"
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                style="@style/edit_text"
                android:textSize="@dimen/large_text"
                android:layout_weight="1"
                android:hint="@string/add_voc_new_translation"
                expandable:hidable="true"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                />
        <Button
                android:id="@+id/add_new_translation_ok"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                style="@style/button"
                android:text="@string/ok"
                android:textSize="@dimen/normal_text"
                expandable:hidable="true"
                android:layout_marginRight="10dp"
                />
    </com.matthieu.flash.widget.ExtendingLinearLayout>
</LinearLayout>